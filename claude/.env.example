# Copy as .env and fill in. Do not commit the real .env.

GITHUB_ORG=gallegovela
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=

# Optional (have default values in docker-compose.yml)
RUNNER_NAME=claude-runner-1
RUNNER_LABELS=ionosL1

# Besides this .env, these files are needed before starting the
# container (mounted by docker-compose.yml, not part of the .env):
#   claude/secrets/github-app-private-key.pem  -> GitHub App private key
#   claude/secrets/id_ed25519                  -> SSH private key for git push
