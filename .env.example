# Copy as .env and fill in. Do not commit the real .env.
# Config for the whole project (docker-compose.yml at repo root, one
# compose file for every runner service).

# Which services to start with `docker compose up`, by profile name
# (comma-separated, no spaces). Each service in docker-compose.yml is
# tagged with a `profiles: [...]` entry -- remove its profile from this
# list to leave it stopped, add it back to enable it again. Docker
# Compose reads COMPOSE_PROFILES from this .env automatically, no
# --profile flag needed on the CLI.
COMPOSE_PROFILES=claude

# System path (outside the repo checkout) where every runner's secrets
# live. Not part of the repo, not baked into any image -- create it on
# the host with restrictive permissions, e.g.:
#   sudo mkdir -p /etc/github-selfhosted-runners/secrets
#   sudo chmod 700 /etc/github-selfhosted-runners/secrets
SECRETS_DIR=/etc/github-selfhosted-runners/secrets

# --- claude-runner ---

GITHUB_ORG=gallegovela
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=

# Optional (have default values in docker-compose.yml)
RUNNER_NAME=claude-runner-1
RUNNER_LABELS=ionosL1

# Besides this .env, these files are needed before starting the
# container (mounted by docker-compose.yml from $SECRETS_DIR, not part
# of the .env):
#   $SECRETS_DIR/github-app-private-key.pem  -> GitHub App private key
#   $SECRETS_DIR/id_ed25519                  -> SSH private key for git push

# --- deploy-docker-runner ---

# Reuses GITHUB_ORG, GITHUB_APP_ID and GITHUB_APP_INSTALLATION_ID above
# (same GitHub App, installed once on the org) and the same
# $SECRETS_DIR/github-app-private-key.pem -- nothing new to configure
# for those. See spec/runner-deploy-docker.md.

# Optional (have default values in docker-compose.yml)
DEPLOY_DOCKER_RUNNER_NAME=deploy-docker-runner-1
DEPLOY_DOCKER_RUNNER_LABELS=deployDocker

# GID of the `docker` group on the host machine (`getent group docker |
# cut -d: -f3`), passed as a build arg so the container's `runner` user
# can use the host's /var/run/docker.sock. Optional, defaults to 999 in
# docker-compose.yml, but check it against the actual host before
# relying on the default.
DOCKER_GID=

# Required, no default: host path (outside the repo) with one
# subdirectory per deployed project (DEPLOY_DIR/<project>), bind-mounted
# 1:1 (same path inside and outside the container). See
# spec/runner-deploy-docker.md for why this can't be a fixed internal
# alias.
DEPLOY_DIR=
