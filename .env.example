# Copy as .env and fill in. Do not commit the real .env.
# Config for the whole project (docker-compose.yml at repo root, one
# compose file for every runner service).

# Which services to start with `docker compose up`, by profile name
# (comma-separated, no spaces). Each service in docker-compose.yml is
# tagged with a `profiles: [...]` entry -- remove its profile from this
# list to leave it stopped, add it back to enable it again. Docker
# Compose reads COMPOSE_PROFILES from this .env automatically, no
# --profile flag needed on the CLI.
COMPOSE_PROFILES=claude

# System path (outside the repo checkout) where every runner's secrets
# live, one subfolder per service. Not part of the repo, not baked into
# any image -- create it on the host with restrictive permissions, e.g.:
#   sudo mkdir -p /etc/github-selfhosted-runners/secrets/claude
#   sudo chmod 700 /etc/github-selfhosted-runners/secrets /etc/github-selfhosted-runners/secrets/claude
SECRETS_DIR=/etc/github-selfhosted-runners/secrets

# --- claude-runner ---

GITHUB_ORG=gallegovela
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=

# Optional (have default values in docker-compose.yml)
RUNNER_NAME=claude-runner-1
RUNNER_LABELS=ionosL1

# Besides this .env, these files are needed before starting the
# container (mounted by docker-compose.yml from $SECRETS_DIR, not part
# of the .env):
#   $SECRETS_DIR/claude/github-app-private-key.pem  -> GitHub App private key
#   $SECRETS_DIR/claude/id_ed25519                  -> SSH private key for git push
